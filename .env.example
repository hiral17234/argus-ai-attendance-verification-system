# =====================================================================
# ARGUS — Institutional AI Attendance & Biometric Verification Platform
# Environment Configuration
# =====================================================================

# Application Configuration
APP_NAME="ARGUS Institutional Identity Verification & Attendance Platform"
APP_VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL primary with automatic SQLite development fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/argus_db"
# Fallback local SQLite URL used when PostgreSQL service is offline:
SQLITE_FALLBACK_URL="sqlite:///./argus_local.db"

# Institutional Email Domains (Strict Institutional Allowlists)
STUDENT_EMAIL_DOMAIN="mitsgwl.ac.in"
TEACHER_EMAIL_DOMAIN="mitsgwalior.ac.in"
ADMIN_EMAIL_DOMAIN="mitsadmin.ac.in"

# JWT Authentication
SECRET_KEY="argus-institutional-secret-key-change-in-production-2026-secure-token"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Institutional Security Policies
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRE_MINUTES=30
DEFAULT_GEOFENCE_RADIUS_METERS=150

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

